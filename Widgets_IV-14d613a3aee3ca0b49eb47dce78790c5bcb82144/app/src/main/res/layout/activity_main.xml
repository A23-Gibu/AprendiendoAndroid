<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Barra de título con icono (app:logo) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorPrimaryContainer"
        app:logo="@drawable/ic_android"
        app:title="@string/titulo_barra"
        app:titleMarginStart="@dimen/separacion_media" />

    <!-- Contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <TextView
            android:id="@+id/tvElige"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elige"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <!-- sustituimos el listview por recyclerview -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProvincias"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/separacion_pequena"
            android:scrollbars="vertical"
            tools:listitem="@layout/fila_provincia" />

        <!-- Resultado: siempre visible debajo de la lista -->
        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion_grande"
            android:freezesText="true"
            android:text="@string/sin_eleccion"
            android:textColor="@color/verde_resultado"
            android:textSize="@dimen/texto_resultado" />

    </LinearLayout>
</LinearLayout>
